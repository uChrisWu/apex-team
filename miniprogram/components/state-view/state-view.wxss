.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  color: #8a8f99;
  font-size: 28rpx;
  text-align: center;
}
.text { margin-top: 20rpx; }
.action {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d33a2c;
  color: #d33a2c;
}
.btn-hover { opacity: 0.7; }
.spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid #e6e8ec;
  border-top-color: #d33a2c;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
