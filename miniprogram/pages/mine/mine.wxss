.login-card { text-align: center; padding: 60rpx 40rpx; }
.login-title { font-size: 34rpx; font-weight: 600; margin-bottom: 12rpx; }
.login-btn { margin-top: 40rpx; }

.actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--c-line);
}
.retry { color: var(--c-brand); }

.dev { margin-top: 40rpx; border: 2rpx dashed #e0b25c; }
.dev-title { margin: 0 0 12rpx; }
.dev-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 26rpx;
}
.dev-users { display: flex; gap: 12rpx; }
.dev-user {
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  background: var(--c-bg);
  font-size: 24rpx;
}
.dev-user--on { background: var(--c-brand-soft); color: var(--c-brand); }
.dev-btns { margin-top: 12rpx; }
