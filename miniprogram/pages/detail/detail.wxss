.head { display: flex; align-items: center; justify-content: space-between; }
.rank { font-size: 40rpx; font-weight: 700; }
.count { margin-top: 12rpx; color: var(--c-text-2); }
.count-num { font-size: 56rpx; font-weight: 700; color: var(--c-text); }
.count-note { margin-left: 16rpx; color: var(--c-brand); font-size: 26rpx; }
.rows { margin-top: 20rpx; border-top: 1rpx solid var(--c-line); padding-top: 12rpx; }
.kv { display: flex; justify-content: space-between; padding: 10rpx 0; }
.k { color: var(--c-text-3); }
.v { color: var(--c-text); }
.note-box { margin-top: 12rpx; }
.note { margin-top: 8rpx; white-space: pre-wrap; word-break: break-all; }
.notice--off { color: var(--c-text-2); background: var(--c-muted-soft); }
.notice-text { font-weight: 600; }
.contact { margin-top: 24rpx; }
.manage-title { margin: 0 0 20rpx; }

.copy-hint { margin-top: 12rpx; text-align: center; }
.req { color: var(--c-brand); margin-left: 4rpx; }
.error { margin-top: 8rpx; font-size: 24rpx; color: var(--c-brand); }
.link-btn { color: var(--c-brand); font-size: 26rpx; }

.my-request {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: var(--c-muted-soft);
}
.my-request--PENDING { background: var(--c-warn-soft); }
.my-request--ACCEPTED { background: var(--c-ok-soft); }
.my-request-head { display: flex; justify-content: space-between; font-weight: 600; }
.my-request .link-btn { margin-top: 12rpx; }

.apply-form { margin-top: 20rpx; }
.apply-label { font-weight: 600; margin: 16rpx 0 12rpx; }
.input {
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--c-bg);
  border-radius: 10rpx;
}
.apply-actions { margin-top: 24rpx; }

.requests-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.request {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--c-line);
}
.request-main { flex: 1; min-width: 0; }
.request-id { font-weight: 600; word-break: break-all; }
.request-meta { margin-top: 8rpx; display: flex; align-items: center; gap: 12rpx; font-size: 22rpx; }
.request-msg { margin-top: 8rpx; color: var(--c-text-2); font-size: 26rpx; word-break: break-all; }
.request-actions { display: flex; flex-direction: column; gap: 12rpx; }
.tag--req-PENDING { background: var(--c-warn-soft); color: var(--c-warn); }
.tag--req-ACCEPTED { background: var(--c-ok-soft); color: var(--c-ok); }

.report { margin-top: 24rpx; text-align: center; font-size: 24rpx; color: var(--c-text-3); }
