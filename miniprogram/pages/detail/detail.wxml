<mock-banner />

<state-view wx:if="{{status === 'loading'}}" status="loading" />
<state-view wx:elif="{{status === 'error'}}" status="error" message="{{errorMessage}}" bindaction="onRetry" />
<state-view wx:elif="{{status === 'notfound'}}" status="empty" message="信息不存在或已删除"
            actionText="返回组队大厅" bindaction="onBackToHall" />

<view wx:else class="container">
  <view class="card">
    <view class="head">
      <view class="rank">{{post.rankName}}</view>
      <view class="tag tag--{{post.status}}">{{post.statusText}}</view>
    </view>
    <view class="count">
      <text class="count-num">{{post.currentPlayers}}</text>/{{post.maxPlayers}} 人
      <text class="count-note">{{post.remainingText}}</text>
    </view>

    <view class="rows">
      <view class="kv"><text class="k">服务器</text><text class="v">{{post.serverName}}</text></view>
      <view class="kv"><text class="k">游戏模式</text><text class="v">{{post.modeName}}</text></view>
      <view class="kv"><text class="k">发布时间</text><text class="v">{{post.publishTimeText}}</text></view>
      <view wx:if="{{post.expireText}}" class="kv"><text class="k">有效期</text><text class="v">{{post.expireText}}</text></view>
    </view>

    <view class="note-box">
      <view class="k">备注</view>
      <view class="note">{{post.note || '无'}}</view>
    </view>
  </view>

  <view wx:if="{{post.status !== 'RECRUITING'}}" class="card notice notice--off">{{post.statusNote}}</view>

  <!-- 非发布者：申请加入与复制联系 -->
  <view wx:if="{{!post.canDelete}}" class="card">
    <view class="notice-text">申请加入后房主会收到提醒，同意后人数自动更新；也可以直接复制游戏 ID 在游戏内联系。</view>

    <view wx:if="{{myRequest && myRequest.status !== 'CANCELLED'}}" class="my-request my-request--{{myRequest.status}}">
      <view class="my-request-head">
        <text>我的申请：{{myRequest.statusText}}</text>
        <text class="muted">{{myRequest.timeText}}</text>
      </view>
      <view wx:if="{{myRequest.status === 'ACCEPTED'}}" class="hint">房主已同意，请留意游戏内的组队邀请。</view>
      <view wx:if="{{myRequest.status === 'PENDING'}}" class="link-btn" bindtap="onCancelApply">撤回申请</view>
    </view>

    <view wx:elif="{{applyOpen}}" class="apply-form">
      <view class="apply-label">你的游戏 ID<text class="req">*</text></view>
      <input class="input" value="{{applyForm.gameId}}" maxlength="{{limits.gameIdMaxLength}}"
             placeholder="房主将用它在游戏内邀请你" data-field="gameId" bindinput="onApplyInput" />
      <view wx:if="{{applyErrors.gameId}}" class="error">{{applyErrors.gameId}}</view>
      <view class="apply-label">留言<text class="muted">（选填）</text></view>
      <input class="input" value="{{applyForm.message}}" maxlength="{{limits.applyMessageMaxLength}}"
             placeholder="例如：常玩恶灵，可以开麦" data-field="message" bindinput="onApplyInput" />
      <view wx:if="{{applyErrors.message}}" class="error">{{applyErrors.message}}</view>
      <view class="btn-row apply-actions">
        <view class="btn" hover-class="btn-hover" bindtap="onCloseApply">取消</view>
        <view class="btn btn--primary {{applying ? 'btn--disabled' : ''}}" hover-class="btn-hover" bindtap="onSubmitApply">
          {{applying ? '发送中…' : '发送申请'}}
        </view>
      </view>
    </view>

    <view wx:elif="{{post.status === 'RECRUITING'}}" class="btn btn--primary contact" hover-class="btn-hover" bindtap="onOpenApply">
      {{myRequest && myRequest.status === 'CANCELLED' ? '重新申请加入' : '申请加入'}}
    </view>

    <view class="btn contact {{post.status !== 'RECRUITING' || copying ? 'btn--disabled' : ''}}"
          hover-class="{{post.status === 'RECRUITING' ? 'btn-hover' : 'none'}}" bindtap="onCopyContact">
      {{post.status !== 'RECRUITING' ? '当前不可联系' : copying ? '正在确认…' : '复制游戏 ID'}}
    </view>
    <view class="hint copy-hint">复制游戏 ID 不会占用名额，也不代表加入成功。</view>
    <button wx:if="{{post.status === 'RECRUITING'}}" class="btn contact share-btn" open-type="share" hover-class="btn-hover">转发给队友</button>
    <view class="report" bindtap="onReport">举报这条信息</view>
  </view>

  <!-- 发布者：转发到群里招人 -->
  <view wx:if="{{post.canDelete && post.status === 'RECRUITING'}}" class="card share-card {{justPublished ? 'share-card--fresh' : ''}}">
    <view class="share-title">{{justPublished ? '发布成功！转发到群里，让更多人看到' : '转发到群里，更快找到队友'}}</view>
    <view class="hint">群友点开卡片即可查看并申请加入。</view>
    <button class="btn btn--primary share-btn" open-type="share" hover-class="btn-hover">转发到微信群</button>
  </view>

  <!-- 发布者：入队申请 -->
  <view wx:if="{{post.canDelete}}" class="card">
    <view class="requests-head">
      <view class="section-title manage-title">入队申请</view>
      <view wx:if="{{canSubscribe && post.status === 'RECRUITING'}}" class="link-btn" bindtap="onSubscribe">开启申请提醒</view>
    </view>
    <view wx:if="{{requestsStatus === 'loading'}}" class="hint">加载中…</view>
    <view wx:elif="{{requestsStatus === 'error'}}" class="hint">申请加载失败，<text class="link-btn" bindtap="loadRequests">重试</text></view>
    <view wx:elif="{{!requests.length}}" class="hint">暂无申请。有人申请时，“我的发布”标签会显示提醒。</view>
    <view wx:for="{{requests}}" wx:key="id" class="request">
      <view class="request-main">
        <view class="request-id">{{item.applicantGameId}}</view>
        <view class="request-meta">
          <text class="tag tag--req-{{item.status}}">{{item.statusText}}</text>
          <text class="muted">{{item.timeText}}</text>
        </view>
        <view wx:if="{{item.message}}" class="request-msg">{{item.message}}</view>
      </view>
      <view class="request-actions">
        <view class="btn btn--small" hover-class="btn-hover" data-gameid="{{item.applicantGameId}}" bindtap="onCopyApplicant">复制 ID</view>
        <block wx:if="{{item.status === 'PENDING'}}">
          <view class="btn btn--small btn--primary {{decidingId === item.id ? 'btn--disabled' : ''}}" hover-class="btn-hover"
                data-id="{{item.id}}" data-decision="ACCEPT" bindtap="onDecide">同意</view>
          <view class="btn btn--small {{decidingId === item.id ? 'btn--disabled' : ''}}" hover-class="btn-hover"
                data-id="{{item.id}}" data-decision="REJECT" bindtap="onDecide">拒绝</view>
        </block>
      </view>
    </view>
  </view>

  <view wx:if="{{post.canEdit || post.canClose || post.canDelete}}" class="card">
    <view class="section-title manage-title">管理我的发布</view>
    <view class="btn-row">
      <view wx:if="{{post.canEdit}}" class="btn" hover-class="btn-hover" bindtap="onEdit">编辑</view>
      <view wx:if="{{post.canClose}}" class="btn" hover-class="btn-hover" bindtap="onClose">结束招募</view>
      <view wx:if="{{post.canDelete}}" class="btn btn--danger" hover-class="btn-hover" bindtap="onDelete">删除</view>
    </view>
  </view>
</view>
