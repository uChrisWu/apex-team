.filters {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--c-surface);
  padding: 16rpx 24rpx 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--c-line);
}
.filter {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--c-bg);
  font-size: 26rpx;
  color: var(--c-text-2);
}
.filter--on { color: var(--c-brand); background: var(--c-brand-soft); }
.arrow { margin-left: 8rpx; font-size: 20rpx; }
.segment {
  display: flex;
  background: var(--c-bg);
  border-radius: 999rpx;
  padding: 4rpx;
}
.seg {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--c-text-2);
}
.seg--on { background: var(--c-surface); color: var(--c-brand); font-weight: 600; }

.container { padding-bottom: 180rpx; }
.retry { color: var(--c-brand); }

.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  padding: 24rpx 40rpx;
  border-radius: 999rpx;
  background: var(--c-brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(211, 58, 44, 0.35);
}
